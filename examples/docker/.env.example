# Copy to .env next to docker-compose.yml and fill in the blanks.
#
#   openssl rand -hex 24   # for each token
#   openssl rand -hex 32   # for the TURN secret

# peer=token pairs for the signaling server. One token per peer ID.
PIPE_SIGNAL_TOKENS=alice=REPLACE_WITH_RANDOM_TOKEN,bob=REPLACE_WITH_RANDOM_TOKEN
SIGNAL_PORT=8080
SIGNAL_MAX_PEERS=1000

# Public IP of the machine running the relay. Clients send relayed traffic
# here, so it must be reachable from the internet on 3478 and the relay range.
TURN_RELAY_IP=203.0.113.10
TURN_REALM=pipe.example
TURN_RELAY_PORTS=49152-49252
TURN_RELAY_MIN=49152
TURN_RELAY_MAX=49252

# Shared secret for ephemeral TURN credentials (TURN REST API / use-auth-secret).
PIPE_TURN_SECRET=REPLACE_WITH_RANDOM_SECRET

# Plans: name=rate[/max concurrent relay sockets]. A rate of 0 is unlimited.
TURN_PLANS=free=512KiB/4,paid=8MiB/32

# Optional static users, user=password[:plan]. Leave empty to rely on the secret.
PIPE_TURN_USERS=
